; Open this file in Godot 4.6 or later. F6/F5 runs the hybrid 2.5D game.
config_version=5

[application]
config/name="Entre Reinos"
config/description="RPG de mundo aberto 2.5D: explore dois reinos, negocie, reúna recursos e construa sua casa."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="EntreFolhas"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=1024
window/size/min_height=640

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.16, 0.23, 0.17, 1)

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true
